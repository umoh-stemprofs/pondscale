{
  "name": "pondscale",
  "version": "0.1.0",
  "private": true,
  "description": "PondScale — is my fish feed right? FCR, growth and feed cost per fish farm.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "postinstall": "prisma generate",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.2",
    "iron-session": "^9.0.1",
    "next": "14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^3.10.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "autoprefixer": "10.4.20",
    "dotenv": "16.4.7",
    "postcss": "8.4.49",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tsx": "4.19.2",
    "typescript": "5.7.3",
    "vitest": "2.1.9"
  }
}
