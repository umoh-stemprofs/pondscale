# Copy to .env and fill in. .env is git-ignored; this file is committed.

# Postgres. Neon in deployment, any Postgres locally (docs/00-global.md §3).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pondscale?schema=public"

# All dates and times are handled in this zone, never the server's clock zone.
APP_TZ="Africa/Lagos"

# --- Added in later steps, listed here so nobody invents new names ---
# 32-byte random value, base64 or hex. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never commit the real value; never print it in chat or logs.
SESSION_SECRET=""
# Show the "Try demo account" button on the login and signup screens.
DEMO_MODE="true"
# Optional OpenWeatherMap key. Without it the app uses Open-Meteo (no key).
# OWM_API_KEY=""
# Optional override of the Open-Meteo base URL (proxy or failure testing).
# WEATHER_API_URL=""
# Optional real market API. Without it the simulated feed is used.
# MARKET_API_URL=""